{
  "info": {
    "_postman_id": "authium-api-collection",
    "name": "Authium API",
    "description": "JWT Authentication and Authorization API Collection for Authium",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Public authentication endpoints",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"testuser\",\n    \"email\": \"testuser@example.com\",\n    \"password\": \"Test@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/authenticate/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "authenticate", "auth", "register"]
            },
            "description": "Register a new user account"
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "}",
                  "if (jsonData.refreshToken) {",
                  "    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"testuser@example.com\",\n    \"password\": \"Test@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/authenticate/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "authenticate", "auth", "login"]
            },
            "description": "Authenticate user and get JWT tokens"
          },
          "response": []
        },
        {
          "name": "OAuth Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "}",
                  "if (jsonData.refreshToken) {",
                  "    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"provider\": \"GOOGLE\",\n    \"idToken\": \"your-oauth-id-token\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/authenticate/auth/oauth",
              "host": ["{{baseUrl}}"],
              "path": ["api", "authenticate", "auth", "oauth"]
            },
            "description": "Authenticate using OAuth provider (Google, Facebook, etc.)"
          },
          "response": []
        },
        {
          "name": "Request Password Reset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"testuser@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/authenticate/auth/reset-request",
              "host": ["{{baseUrl}}"],
              "path": ["api", "authenticate", "auth", "reset-request"]
            },
            "description": "Request a password reset email"
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"token\": \"reset-token-from-email\",\n    \"email\": \"testuser@example.com\",\n    \"newPassword\": \"NewTest@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/authenticate/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "authenticate", "auth", "reset-password"]
            },
            "description": "Reset password using the token from email"
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "}",
                  "if (jsonData.refreshToken) {",
                  "    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/authenticate/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "authenticate", "auth", "refresh"]
            },
            "description": "Refresh access token using refresh token"
          },
          "response": []
        }
      ]
    },
    {
      "name": "User",
      "description": "Authenticated user endpoints",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/authenticate/user/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "authenticate", "user", "me"]
            },
            "description": "Get current authenticated user's profile"
          },
          "response": []
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"updateduser\",\n    \"email\": \"updated@example.com\",\n    \"password\": \"NewPassword@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/authenticate/user/update",
              "host": ["{{baseUrl}}"],
              "path": ["api", "authenticate", "user", "update"]
            },
            "description": "Update current user's profile information"
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/authenticate/user/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "authenticate", "user", "logout"]
            },
            "description": "Logout current user and invalidate token"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin",
      "description": "Admin-only endpoints (requires ADMIN role)",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/authenticate/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "authenticate", "admin", "users"]
            },
            "description": "Get all users (Admin only)"
          },
          "response": []
        },
        {
          "name": "Get User By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/authenticate/admin/users/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "authenticate", "admin", "users", "1"]
            },
            "description": "Get a specific user by ID (Admin only)"
          },
          "response": []
        },
        {
          "name": "Update User Roles",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"roleName\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/authenticate/admin/users/1/roles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "authenticate", "admin", "users", "1", "roles"]
            },
            "description": "Update roles for a specific user (Admin only)"
          },
          "response": []
        },
        {
          "name": "Create Role",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"roleName\": \"MODERATOR\",\n    \"description\": \"Moderator role with limited admin access\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/authenticate/admin/roles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "authenticate", "admin", "roles"]
            },
            "description": "Create a new role (Admin only)"
          },
          "response": []
        },
        {
          "name": "Get Audit Logs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/authenticate/admin/audit-logs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "authenticate", "admin", "audit-logs"]
            },
            "description": "Get all audit logs (Admin only)"
          },
          "response": []
        },
        {
          "name": "Delegate Permissions",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"userId\": 2,\n    \"role\": \"MODERATOR\",\n    \"reason\": \"Promoting user to moderator\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/authenticate/admin/delegate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "authenticate", "admin", "delegate"]
            },
            "description": "Delegate permissions to a user (Admin only)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Health",
      "description": "Health check endpoint",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/authenticate/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "authenticate", "health"]
            },
            "description": "Check if the API is running"
          },
          "response": []
        }
      ]
    }
  ]
}
